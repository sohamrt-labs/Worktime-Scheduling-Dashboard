# Copy to .env and change the values. Never commit .env.
SECRET_KEY=change-me-use-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too
# Leave DATABASE_URL unset for SQLite (local: ./worktime.db, Docker: persistent volume).
# DATABASE_URL=sqlite:///./worktime.db
# PostgreSQL example (docker compose --profile postgres):
# DATABASE_URL=postgresql+psycopg2://worktime:worktime@db:5432/worktime
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
TOKEN_EXPIRE_MINUTES=60
# Allow people to create their own accounts (each gets its own private businesses)
ALLOW_SIGNUP=true
ADMIN_EMAIL=admin@example.com
# Public address of the app (used in email links) and the contact shown on the Terms/Privacy pages
# APP_URL=http://localhost:5173
# CONTACT_EMAIL=you@example.com
# Email sending. Leave SMTP_HOST empty in development: emails are printed in the backend window instead.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Work-Time <no-reply@example.com>
# Optional: people must enter this code to create an account
# INVITE_CODE=
# Limits per business / per user (abuse protection)
# MAX_ROWS_PER_TABLE=5000
# MAX_BUSINESSES_PER_USER=10
APP_TIMEZONE=Asia/Kolkata
