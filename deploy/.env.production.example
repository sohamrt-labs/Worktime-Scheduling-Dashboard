# Copy to .env.production (never commit it) and fill in every value. See DEPLOY.md.
DOMAIN=app.example.com
# Generate with:  openssl rand -hex 32
SECRET_KEY=
# Letters and digits only (it is embedded in a URL). Generate with:  openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_USER=worktime
POSTGRES_DB=worktime
APP_TIMEZONE=Asia/Kolkata
TOKEN_EXPIRE_MINUTES=480
ALLOW_SIGNUP=true
# Shown on the Terms of Service and Privacy Policy pages
CONTACT_EMAIL=
# Email provider (Brevo, Mailgun, Amazon SES, Gmail SMTP ...). Needed for email confirmation and password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Work-Time <no-reply@app.example.com>
# Optional but recommended while you are testing in public: people must enter this code to create an account.
INVITE_CODE=
